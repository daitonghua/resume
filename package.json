{
  "name": "resume",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "戴瞳华个人简历：单一数据源 → 网站（动态/静态多版本） + PDF（裁剪版/完整版三语）",
  "scripts": {
    "build": "node tools/build.mjs",
    "pdf": "node tools/build-pdf.mjs",
    "all": "node tools/build.mjs && node tools/build-pdf.mjs",
    "check": "node tools/build.mjs --check",
    "verify": "node tools/verify-pdf.mjs",
    "verify:live": "node tools/verify-live.mjs",
    "page-report": "node tools/page-report.mjs",
    "fit-report": "node tools/fit-report.mjs",
    "verify:meta": "node tools/verify-metadata.mjs",
    "verify:artifacts": "node tools/verify-artifacts.mjs",
    "verify:cjk": "node tools/verify-cjk.mjs",
    "verify:clean": "node tools/verify-clean.mjs",
    "verify:downloads": "node tools/verify-downloads.mjs",
    "predeploy": "node tools/predeploy.mjs",
    "text:export": "node tools/export-text.mjs",
    "text:import": "node tools/import-text.mjs",
    "text:check": "node tools/import-text.mjs --dry"
  },
  "dependencies": {
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "pdfjs-dist": "^6.3.289"
  }
}
